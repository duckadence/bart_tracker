{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "PlatformIO: Verify (Build)",
            "type": "shell",
            "command": "pio run -d firmware -e esp32dev",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "PlatformIO: Upload",
            "type": "shell",
            "command": "pio run -d firmware -e esp32dev -t upload --upload-port COM5",
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "PlatformIO: Serial Monitor",
            "type": "shell",
            "command": "pio device monitor -p COM5 -b 115200 -d firmware",
            "group": "none",
            "problemMatcher": []
        }
    ]
}